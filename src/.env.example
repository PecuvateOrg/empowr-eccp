# Add blank variable names here before introducing an external service.

# Coaching grade (planning/sql/coaching-grade.sql applied 2026-11-21). 1 = on.
ECCP_COACHING_GRADE_ENABLED=

# Messaging (coach enquiries, Staff Inbox, Dashboard feed). Switched on 2026-11-21. "true" = on.
ECCP_MESSAGING_ENABLED=
# Shared with the Empowr Dashboard work list (x-staff-queue-secret). SSM + Vault ECCP_QUEUE_SECRET_PROD.
ECCP_QUEUE_SECRET=

# EFN coach-work and staff scheduling APIs (server to server). Values in SSM; Vault SHARED_EFN_ECCP_API_KEY_PROD / SHARED_EFN_ECCP_STAFF_API_KEY_PROD
ECCP_EFN_API_KEY=
ECCP_EFN_STAFF_API_KEY=
